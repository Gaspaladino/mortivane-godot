; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Mortivane"
config/description="Reconstrução de Mortivane (referência: MortivaneV97.html)."
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.0431373, 0.0352941, 0.0627451, 1)

[display]

